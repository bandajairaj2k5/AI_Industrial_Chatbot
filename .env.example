# Configuration for AI-Powered Industrial Chatbot
# Copy this file to .env and configure your actual values.
# NEVER commit your actual .env file or API keys to version control.

# Inference mode: "remote" (Groq remote inference, fast, low RAM) or "local" (Hugging Face Transformers on CPU)
INFERENCE_BACKEND=remote

# Groq API Configuration
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Alternatively, LLM_API_KEY is also recognized:
# LLM_API_KEY=your_groq_api_key_here

# Groq Model ID (verified active models: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3.8-27b

# Groq API Endpoint (OpenAI-compatible chat completions)
GROQ_BASE_URL=https://api.groq.com/openai/v1
